@page
@model Morourak.Dashboard.Pages.Staff.AppointmentsModel
@{
    ViewData["Title"] = "قائمة المواعيد اليومية";
    ViewData["ActivePage"] = "Appointments";
    var total = Model.Appointments.Count();
    // Use Arabic strings for status checks since API returns localized names
    var pending = Model.Appointments.Count(a => a.Status == "محجوز" || a.Status == "قيد الانتظار" || a.Status == "Scheduled" || a.Status == "Pending");
}

<div class="animate-fade-in space-y-xl">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-2xl p-5 font-bold text-sm">
            @Model.ErrorMessage
        </div>
    }
    <header class="flex flex-col gap-xs">
        <nav class="flex items-center gap-xs text-secondary/50 font-bold text-[12px] mb-2">
            <a class="hover:text-primary transition-colors" asp-page="/Index">الرئيسية</a>
            <span class="material-symbols-outlined text-sm">chevron_left</span>
            <span class="text-primary">إدارة المواعيد</span>
        </nav>
        <div class="flex justify-between items-end">
            <div>
                <h1 class="font-headline text-3xl font-black text-secondary">إدارة المواعيد</h1>
                <p class="text-secondary/50 text-sm font-medium">متابعة وتسجيل نتائج الفحوصات والاختبارات المقررة ليوم @(Model.SelectedDate?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-EG")))</p>
            </div>
            <form method="get" id="dateFilterForm" class="flex items-center gap-md bg-white px-6 py-3 rounded-2xl border border-primary/10 shadow-sm focus-within:ring-2 ring-primary/20 transition-all hover:border-primary/30">
                <label for="SelectedDate" class="flex items-center gap-md cursor-pointer">
                    <span class="material-symbols-outlined text-primary">calendar_today</span>
                    <input type="date" name="SelectedDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" onchange="this.form.submit()" 
                           class="border-none focus:ring-0 p-0 text-sm font-bold text-secondary bg-transparent cursor-pointer" />
                </label>
            </form>
        </div>
    </header>

    <section class="grid grid-cols-12 gap-lg mb-xl">
        <div class="col-span-12 md:col-span-4 bg-white p-6 rounded-[24px] border border-primary/10 shadow-sm flex items-center gap-6">
            <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-4xl">event_available</span>
            </div>
            <div>
                <p class="text-secondary/40 text-[11px] font-bold uppercase tracking-widest">إجمالي المواعيد</p>
                <h3 class="text-3xl font-black text-secondary">@total</h3>
            </div>
        </div>
        <div class="col-span-12 md:col-span-4 bg-white p-6 rounded-[24px] border border-primary/10 shadow-sm flex items-center gap-6 border-r-4 border-r-orange-500">
            <div class="w-16 h-16 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-500">
                <span class="material-symbols-outlined text-4xl">pending_actions</span>
            </div>
            <div>
                <p class="text-secondary/40 text-[11px] font-bold uppercase tracking-widest">انتظار المراجعة</p>
                <h3 class="text-3xl font-black text-orange-500">@pending</h3>
            </div>
        </div>
        <div class="col-span-12 md:col-span-4 bg-white p-6 rounded-[24px] border border-primary/10 shadow-sm flex items-center gap-6 border-r-4 border-r-primary">
            <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-4xl">task_alt</span>
            </div>
            <div>
                <p class="text-secondary/40 text-[11px] font-bold uppercase tracking-widest">تم إنجازه</p>
                <h3 class="text-3xl font-black text-primary">@(total - pending)</h3>
            </div>
        </div>
    </section>

    <div class="bg-white rounded-[32px] overflow-hidden border border-primary/10 shadow-sm">
        <div class="p-8 border-b border-primary/5 flex flex-col md:flex-row justify-between items-center gap-lg bg-white/50 backdrop-blur-sm">
            <div class="relative flex-1 max-w-md">
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-secondary/40">search</span>
                <input id="appointmentSearch" class="w-full bg-background border border-primary/5 rounded-xl pr-12 py-3 text-sm focus:ring-primary focus:border-primary font-medium" placeholder="ابحث برقم الهوية أو المعاملة..." type="text"/>
            </div>
            <div class="flex items-center gap-md">
                <div class="flex bg-background p-1 rounded-xl border border-primary/5">
                    <button type="button" data-status="all" class="appointment-filter px-6 py-2 rounded-lg bg-white text-primary font-bold text-xs shadow-sm">الكل</button>
                    <button type="button" data-status="pending" class="appointment-filter px-6 py-2 rounded-lg text-secondary/40 font-bold text-xs hover:text-secondary transition-colors">قيد الانتظار</button>
                    <button type="button" data-status="completed" class="appointment-filter px-6 py-2 rounded-lg text-secondary/40 font-bold text-xs hover:text-secondary transition-colors">مكتمل</button>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead>
                    <tr class="bg-background border-b border-primary/10">
                        <th class="px-8 py-4 text-[11px] font-black text-secondary/40 uppercase tracking-widest">المواطن / المتقدم</th>
                        <th class="px-8 py-4 text-[11px] font-black text-secondary/40 uppercase tracking-widest">تفاصيل الموعد</th>
                        <th class="px-8 py-4 text-[11px] font-black text-secondary/40 uppercase tracking-widest">رقم المعاملة</th>
                        <th class="px-8 py-4 text-[11px] font-black text-secondary/40 uppercase tracking-widest">الحالة</th>
                        <th class="px-8 py-4 text-[11px] font-black text-secondary/40 uppercase tracking-widest text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-primary/5">
                    @if (!Model.Appointments.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-8 py-12 text-center text-secondary/50 font-bold">
                                لا توجد مواعيد لهذا اليوم. جرّب تغيير التاريخ من الأعلى.
                            </td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var appointment in Model.Appointments)
                    {
                        <tr class="appointment-row hover:bg-primary/[0.01] transition-colors group"
                            data-status="@((appointment.Status == "محجوز" || appointment.Status == "قيد الانتظار" || appointment.Status == "Scheduled" || appointment.Status == "Pending") ? "pending" : ((appointment.Status == "مكتمل" || appointment.Status == "ناجح" || appointment.Status == "Completed" || appointment.Status == "Passed") ? "completed" : "other"))"
                            data-search="@($"{appointment.CitizenNationalId} {appointment.RequestNumberRelated} {appointment.TypeName} {appointment.DateFormatted} {appointment.TimeFormatted}".ToLowerInvariant())">
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-2xl bg-background border border-primary/10 flex items-center justify-center text-primary font-black shadow-sm group-hover:scale-110 transition-transform">
                                        <span class="material-symbols-outlined">person</span>
                                    </div>
                                    <div>
                                        <p class="font-headline text-base font-black text-secondary">@appointment.CitizenNationalId</p>
                                        <p class="text-[10px] font-bold text-secondary/40 uppercase tracking-tighter">هوية وطنية نشطة</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-primary"></span>
                                        <p class="text-sm font-bold text-secondary">@appointment.TypeName</p>
                                    </div>
                                    <p class="text-[10px] text-secondary/40 font-bold uppercase tracking-widest mr-4">@appointment.TimeFormatted - @appointment.DateFormatted</p>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span class="px-4 py-1.5 bg-background border border-primary/10 rounded-lg text-xs font-black text-primary tracking-widest">#@appointment.RequestNumberRelated</span>
                            </td>
                            <td class="px-8 py-6">
                                @if (appointment.Status == "محجوز" || appointment.Status == "قيد الانتظار" || appointment.Status == "Scheduled" || appointment.Status == "Pending")
                                {
                                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-orange-50 text-orange-600 rounded-full text-[10px] font-black uppercase border border-orange-100">
                                        <span class="w-1.5 h-1.5 bg-orange-500 rounded-full animate-pulse"></span>
                                        بانتظار الفحص
                                    </span>
                                }
                                else if (appointment.Status == "مكتمل" || appointment.Status == "ناجح" || appointment.Status == "Completed" || appointment.Status == "Passed")
                                {
                                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary/10 text-primary rounded-full text-[10px] font-black uppercase border border-primary/10">
                                        <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                                        تم التسجيل
                                    </span>
                                }
                                else if (appointment.Status == "قيد التنفيذ" || appointment.Status == "InProgress")
                                {
                                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-50 text-blue-600 rounded-full text-[10px] font-black uppercase border border-blue-100">
                                        <span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-bounce"></span>
                                        قيد الفحص الآن
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-secondary/10 text-secondary rounded-full text-[10px] font-black uppercase border border-secondary/10">
                                        @appointment.Status
                                    </span>
                                }
                            </td>
                            <td class="px-8 py-6">
                                <div class="flex items-center justify-center gap-3">
                                    @if (appointment.Status == "محجوز" || appointment.Status == "قيد الانتظار" || appointment.Status == "Scheduled" || appointment.Status == "Pending" || appointment.Status == "InProgress" || appointment.Status == "قيد التنفيذ")
                                    {
                                        <a asp-page="/Staff/Result" asp-route-id="@appointment.Id" class="px-6 py-2.5 bg-primary text-white rounded-xl text-[10px] font-black uppercase shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all flex items-center gap-2">
                                            <span>@( (appointment.Status == "InProgress" || appointment.Status == "قيد التنفيذ") ? "استكمال الفحص" : "بدء الفحص" )</span>
                                            <span class="material-symbols-outlined text-sm">@( (appointment.Status == "InProgress" || appointment.Status == "قيد التنفيذ") ? "arrow_forward" : "play_arrow" )</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <button disabled class="px-6 py-2.5 bg-background text-secondary/20 rounded-xl text-[10px] font-black uppercase border border-primary/5 cursor-not-allowed">
                                            مكتمل
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    }
                    <tr id="noResultsRow" class="hidden">
                        <td colspan="5" class="px-8 py-12 text-center text-secondary/50 font-bold">
                            لا توجد مواعيد مطابقة للبحث/التصفية.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="px-8 py-6 bg-background border-t border-primary/10 flex items-center justify-between">
            <p class="text-secondary/50 text-[11px] font-bold uppercase tracking-widest">إجمالي المواعيد: @total</p>
            <div class="flex gap-2">
                <button class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-black shadow-lg shadow-primary/20">1</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const searchInput = document.getElementById('appointmentSearch');
        const filterButtons = Array.from(document.querySelectorAll('.appointment-filter'));
        const rows = Array.from(document.querySelectorAll('tr.appointment-row'));
        const noResultsRow = document.getElementById('noResultsRow');

        let activeStatus = 'all';

        function setActiveButton(status) {
            filterButtons.forEach(btn => {
                const isActive = (btn.getAttribute('data-status') === status);
                btn.classList.toggle('bg-white', isActive);
                btn.classList.toggle('text-primary', isActive);
                btn.classList.toggle('shadow-sm', isActive);
                btn.classList.toggle('text-secondary/40', !isActive);
            });
        }

        function applyFilters() {
            const q = (searchInput?.value || '').trim().toLowerCase();
            let visible = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || 'other';
                const rowSearch = row.getAttribute('data-search') || '';

                const statusOk = (activeStatus === 'all') || (rowStatus === activeStatus);
                const searchOk = !q || rowSearch.includes(q);

                const show = statusOk && searchOk;
                row.classList.toggle('hidden', !show);
                if (show) visible++;
            });

            if (noResultsRow) {
                noResultsRow.classList.toggle('hidden', visible !== 0);
            }
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                activeStatus = btn.getAttribute('data-status') || 'all';
                setActiveButton(activeStatus);
                applyFilters();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }

        setActiveButton(activeStatus);
        applyFilters();
    })();
</script>
