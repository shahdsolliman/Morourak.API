@page "{id}"
@model ResultModel
@{
    ViewData["Title"] = "تسجيل نتيجة الفحص";
    ViewData["ActivePage"] = "Appointments";
}

<form method="post" class="animate-fade-in space-y-xl">
    <input type="hidden" asp-for="AppointmentId" />
    <input type="hidden" asp-for="Input.RequestNumber" />
    <input type="hidden" asp-for="Input.Passed" id="isSuccessInput" />

    <header class="flex items-center justify-between mb-xl">
        <div class="space-y-1">
            <nav class="flex items-center gap-xs text-secondary/50 text-[12px] font-bold">
                <a class="hover:text-primary" asp-page="/Index">الرئيسية</a>
                <span class="material-symbols-outlined text-[14px]">chevron_left</span>
                <a class="hover:text-primary" asp-page="/Staff/Appointments">المواعيد</a>
                <span class="material-symbols-outlined text-[14px]">chevron_left</span>
                <span class="text-primary">تسجيل النتيجة</span>
            </nav>
            <h1 class="font-headline text-3xl font-extrabold text-secondary">تسجيل نتيجة الفحص</h1>
            <p class="text-secondary/50 text-sm font-medium">رقم المعاملة: #@Model.Appointment?.RequestNumberRelated</p>
        </div>
    </header>

    <section class="bg-white rounded-2xl p-6 mb-xl flex items-center justify-between border border-primary/10 shadow-sm">
        <div class="flex items-center gap-xl">
            <div class="relative">
                <div class="w-20 h-20 rounded-2xl bg-primary/10 flex items-center justify-center text-primary border border-primary/20 shadow-sm">
                    <span class="material-symbols-outlined text-4xl">person</span>
                </div>
                <div class="absolute -bottom-1 -left-1 bg-white rounded-full p-1 border border-primary/20">
                    <div class="w-3 h-3 bg-primary rounded-full"></div>
                </div>
            </div>
            <div class="space-y-1">
                <h2 class="font-headline text-2xl font-black text-secondary">@Model.Appointment?.CitizenNationalId</h2>
                <div class="flex gap-lg">
                    <div class="flex items-center gap-xs text-secondary/60">
                        <span class="material-symbols-outlined text-[18px]">badge</span>
                        <span class="text-xs font-bold">هوية رقم: @Model.Appointment?.CitizenNationalId</span>
                    </div>
                    <div class="flex items-center gap-xs text-secondary/60">
                        <span class="material-symbols-outlined text-[18px]">directions_car</span>
                        <span class="text-xs font-bold">نوع الطلب: @Model.Appointment?.TypeName</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-left space-y-1">
            <span class="block text-[10px] font-bold text-secondary/40 uppercase tracking-widest">تاريخ الموعد</span>
            <span class="block font-headline text-lg font-black text-secondary">@Model.Appointment?.DateFormatted</span>
            <span class="inline-block px-3 py-1 bg-orange-100 text-orange-600 rounded-full text-[10px] font-bold border border-orange-200">قيد الفحص الآن</span>
        </div>
    </section>

    <section class="bg-white rounded-2xl p-8 border border-primary/10 shadow-sm">
        <h3 class="font-headline text-lg font-black text-primary mb-6">النتيجة النهائية</h3>
        <div class="grid grid-cols-2 gap-lg">
            <button type="button" onclick="setResult(true)" id="passBtn" class="result-btn flex items-center justify-center gap-xl py-8 border-2 border-primary/10 bg-background rounded-2xl hover:border-primary/30 transition-all group">
                <span class="material-symbols-outlined text-5xl text-primary/40 group-hover:text-primary group-[.selected]:text-primary group-[.selected]:scale-110 transition-all">check_circle</span>
                <div class="text-right">
                    <span class="block text-xl font-black text-secondary group-hover:text-primary group-[.selected]:text-primary transition-colors">اجتياز (ناجح)</span>
                    <span class="text-xs font-bold text-secondary/40">المتقدم استوفى جميع الشروط</span>
                </div>
            </button>
            <button type="button" onclick="setResult(false)" id="failBtn" class="result-btn flex items-center justify-center gap-xl py-8 border-2 border-red-500/10 bg-background rounded-2xl hover:border-red-500/30 transition-all group">
                <span class="material-symbols-outlined text-5xl text-red-500/40 group-hover:text-red-500 group-[.selected]:text-red-500 group-[.selected]:scale-110 transition-all">cancel</span>
                <div class="text-right">
                    <span class="block text-xl font-black text-secondary group-hover:text-red-500 group-[.selected]:text-red-500 transition-colors">رسوب (غير ناجح)</span>
                    <span class="text-xs font-bold text-secondary/40">يجب إعادة الفحص في وقت لاحق</span>
                </div>
            </button>
        </div>
    </section>

    <div class="grid grid-cols-12 gap-lg">
        @if (User.IsInRole("INSPECTOR"))
        {
            <div class="col-span-12 lg:col-span-6 bg-white rounded-2xl p-8 border border-primary/10 shadow-sm">
                <div class="flex items-center gap-md mb-8 border-r-4 border-primary pr-4">
                    <span class="material-symbols-outlined text-primary text-3xl">engineering</span>
                    <h3 class="font-headline text-lg font-black text-secondary">المعاينة الفنية للمركبة</h3>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <label class="p-4 bg-background rounded-xl flex items-center justify-between border border-primary/5 cursor-pointer hover:bg-primary/5 transition-all">
                        <span class="text-xs font-bold text-secondary">الفرامل</span>
                        <input type="checkbox" asp-for="Input.BrakesOk" class="w-5 h-5 rounded-lg border-primary/20 text-primary focus:ring-primary" />
                    </label>
                    <label class="p-4 bg-background rounded-xl flex items-center justify-between border border-primary/5 cursor-pointer hover:bg-primary/5 transition-all">
                        <span class="text-xs font-bold text-secondary">الأنوار</span>
                        <input type="checkbox" asp-for="Input.LightsOk" class="w-5 h-5 rounded-lg border-primary/20 text-primary focus:ring-primary" />
                    </label>
                    <label class="p-4 bg-background rounded-xl flex items-center justify-between border border-primary/5 cursor-pointer hover:bg-primary/5 transition-all">
                        <span class="text-xs font-bold text-secondary">الإطارات</span>
                        <input type="checkbox" asp-for="Input.TiresOk" class="w-5 h-5 rounded-lg border-primary/20 text-primary focus:ring-primary" />
                    </label>
                    <label class="p-4 bg-background rounded-xl flex items-center justify-between border border-primary/5 cursor-pointer hover:bg-primary/5 transition-all">
                        <span class="text-xs font-bold text-secondary">الهيكل</span>
                        <input type="checkbox" asp-for="Input.BodyOk" class="w-5 h-5 rounded-lg border-primary/20 text-primary focus:ring-primary" />
                    </label>
                </div>
            </div>
        }

        @if (User.IsInRole("EXAMINATOR"))
        {
            <div class="col-span-12 lg:col-span-6 bg-white rounded-2xl p-8 border border-primary/10 shadow-sm">
                <div class="flex items-center gap-md mb-8 border-r-4 border-primary pr-4">
                    <span class="material-symbols-outlined text-primary text-3xl">sports_score</span>
                    <h3 class="font-headline text-lg font-black text-secondary">تقييم اختبار القيادة</h3>
                </div>
                <div class="space-y-6">
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold text-secondary">الوقوف والاصطفاف (Parking)</span>
                            <span class="text-sm font-black text-primary" id="parkingScoreVal">@Model.Input.ParkingScore/100</span>
                        </div>
                        <input type="range" asp-for="Input.ParkingScore" min="0" max="100" class="w-full h-2 bg-background rounded-full appearance-none accent-primary cursor-pointer" oninput="updateScore('parking', this.value)" />
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold text-secondary">التحكم في الطريق (Control)</span>
                            <span class="text-sm font-black text-primary" id="controlScoreVal">@Model.Input.RoadControlScore/100</span>
                        </div>
                        <input type="range" asp-for="Input.RoadControlScore" min="0" max="100" class="w-full h-2 bg-background rounded-full appearance-none accent-primary cursor-pointer" oninput="updateScore('control', this.value)" />
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold text-secondary">اللتزام بالأنظمة (Rules)</span>
                            <span class="text-sm font-black text-primary" id="rulesScoreVal">@Model.Input.RulesComplianceScore/100</span>
                        </div>
                        <input type="range" asp-for="Input.RulesComplianceScore" min="0" max="100" class="w-full h-2 bg-background rounded-full appearance-none accent-primary cursor-pointer" oninput="updateScore('rules', this.value)" />
                    </div>
                </div>
            </div>
        }

        <div class="col-span-12 bg-white rounded-2xl p-8 border border-primary/10 shadow-sm">
            <h3 class="font-headline text-lg font-black text-primary mb-6">ملاحظات الفاحص التفصيلية</h3>
            <textarea asp-for="Input.Notes" class="w-full bg-background border border-primary/5 rounded-2xl p-6 focus:ring-2 focus:ring-primary focus:border-primary text-sm font-medium text-secondary" placeholder="يرجى كتابة أي ملاحظات إضافية هنا..." rows="4"></textarea>
        </div>

        <div class="col-span-12 flex justify-end gap-md pt-6">
            <a asp-page="/Staff/Appointments" class="px-10 py-4 bg-background text-secondary/50 font-bold rounded-2xl hover:bg-secondary/5 transition-all text-sm">
                إلغاء العملية
            </a>
            <button type="submit" class="px-10 py-4 bg-primary text-white font-black rounded-2xl shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-3">
                <span>اعتماد وتسجيل النتيجة</span>
                <span class="material-symbols-outlined text-xl">send</span>
            </button>
        </div>
    </div>
</form>

<style>
    .result-btn.selected {
        border-color: currentColor;
        box-shadow: 0 10px 30px -10px currentColor;
    }
</style>

<script>
    function setResult(success) {
        document.getElementById('isSuccessInput').value = success;
        const passBtn = document.getElementById('passBtn');
        const failBtn = document.getElementById('failBtn');
        if (success) {
            passBtn.classList.add('selected', 'border-primary', 'bg-primary/5', 'text-primary');
            failBtn.classList.remove('selected', 'border-red-500', 'bg-red-500/5', 'text-red-500');
        } else {
            failBtn.classList.add('selected', 'border-red-500', 'bg-red-500/5', 'text-red-500');
            passBtn.classList.remove('selected', 'border-primary', 'bg-primary/5', 'text-primary');
        }
    }
    function updateScore(type, val) {
        document.getElementById(type + 'ScoreVal').innerText = val + '/100';
    }
</script>
